title: "Golos: offline Russian voice dictation for Linux"
type: software
version: 0.1.0
date-released: 2026-08-04
license: MIT
repository-code: "https://github.com/geft1310-hue/golos"
url: "https://geft1310-hue.github.io/golos/en/"
authors:
  - name: "geft1310-hue"
    alias: "geft1310-hue"
